# Copy to .env next to the compose file. Everything here is optional unless marked REQUIRED.
# Since 0.8.0 there are no passwords: everybody signs in with the OIDC provider below.

# --- image -------------------------------------------------------------
# PATCHCAST_IMAGE=ghcr.io/sp3lllz/patchcast-server:0.8.0

# --- simple compose ----------------------------------------------------
# HTTP_PORT=8080
# BIND=0.0.0.0              # 127.0.0.1 when a reverse proxy on this host is the only way in

# --- server ------------------------------------------------------------
PUBLIC_URL=https://pods.example.com     # REQUIRED (simple compose; the Traefik compose derives it from PATCHCAST_HOST). Origin only
# BASE_PATH=/podcasts                   # when served below a path
# TRUST_PROXY=false                     # false | hops (1) | IPs/CIDRs | loopback,uniquelocal
# SESSION_SECRET=                       # 32+ chars; auto-generated into /data when empty
# FEED_REFRESH_MINUTES=60
# LOG_LEVEL=info
# TZ=Europe/London
# SSRF_ALLOW_HOSTS=                     # host[:port],… on your LAN that feeds may be fetched from

# --- Pocket ID / OIDC: REQUIRED (see "Pocket ID setup" in README.md) ----
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=                     # or OIDC_CLIENT_SECRET_FILE=/run/secrets/…; empty only for a public client
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_AUTO_CREATE=true                 # a person's first sign-in creates their account
# OIDC_ALLOWED_GROUPS=                  # CSV of group names; empty = everybody who can use the client
# OIDC_ADMIN_GROUPS=                    # empty: the very first sign-in on an empty server becomes administrator

# --- Traefik compose ---------------------------------------------------
PATCHCAST_HOST=pods.example.com         # required for docker-compose.traefik.yml
# TRAEFIK_NETWORK=traefik
# TRAEFIK_CERTRESOLVER=letsencrypt
# PATCHCAST_RULE=Host(`example.com`) && PathPrefix(`/podcasts`)
