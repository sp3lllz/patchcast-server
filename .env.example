# Copy to .env next to the compose file. Everything here is optional unless marked.

# --- image -------------------------------------------------------------
# PATCHCAST_IMAGE=ghcr.io/sp3lllz/patchcast-server:0.7.0

# --- simple compose ----------------------------------------------------
# HTTP_PORT=8080
# BIND=0.0.0.0              # 127.0.0.1 when a reverse proxy on this host is the only way in

# --- server ------------------------------------------------------------
# PUBLIC_URL=https://pods.example.com   # origin only; Secure cookies + allowed Origin
# BASE_PATH=/podcasts                   # when served below a path
# TRUST_PROXY=false                     # false | hops (1) | IPs/CIDRs | loopback,uniquelocal
# ALLOW_REGISTRATION=false
# SESSION_SECRET=                       # 32+ chars; auto-generated into /data when empty
# FEED_REFRESH_MINUTES=60
# LOG_LEVEL=info
# TZ=Europe/London
# ADMIN_USER=patch                      # both set = admin created on first start instead of the setup token
# ADMIN_PASSWORD=
# SSRF_ALLOW_HOSTS=                     # host[:port],… on your LAN that feeds may be fetched from

# --- Pocket ID / OIDC (see "Pocket ID setup" in README.md; needs PUBLIC_URL) ---
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=                   # or OIDC_CLIENT_SECRET_FILE=/run/secrets/…
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_AUTO_CREATE=true
# OIDC_ALLOWED_GROUPS=                  # CSV of group names; empty = everybody who can use the client
# OIDC_ADMIN_GROUPS=
# OIDC_PASSWORD_LOGIN=true

# --- Traefik compose ---------------------------------------------------
PATCHCAST_HOST=pods.example.com         # required for docker-compose.traefik.yml
# TRAEFIK_NETWORK=traefik
# TRAEFIK_CERTRESOLVER=letsencrypt
# PATCHCAST_RULE=Host(`example.com`) && PathPrefix(`/podcasts`)
